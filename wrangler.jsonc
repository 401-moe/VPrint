{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vprint-preview",
  "routes": [{ "pattern": "vprint.401.moe", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "index.html", "vite.config.ts"]
  },
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vprint-preview",
      "database_id": "0c671760-d905-460e-a212-7be0b0eda572",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://vprint.401.moe"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@vprint.401.moe"]
    }
  ],
  "durable_objects": { "bindings": [{ "name": "NOTIFICATIONS", "class_name": "UserNotifications" }] },
  "migrations": [{ "tag": "notifications-v1", "new_sqlite_classes": ["UserNotifications"] }]
}
