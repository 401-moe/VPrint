{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vprint-preview",
  "routes": [
    { "pattern": "vprint.ac", "custom_domain": true },
    { "pattern": "pr.vprint.ac", "custom_domain": true, "enabled": false, "previews_enabled": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "index.html", "vite.config.ts"]
  },
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vprint-preview",
      "database_id": "0c671760-d905-460e-a212-7be0b0eda572",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://vprint.ac"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@vprint.ac"]
    }
  ],
  "durable_objects": { "bindings": [{ "name": "NOTIFICATIONS", "class_name": "UserNotifications" }] },
  "migrations": [{ "tag": "notifications-v1", "new_sqlite_classes": ["UserNotifications"] }],
  "previews": {
    "vars": { "VPRINT_PREVIEW_DOMAIN": "pr.vprint.ac" },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "vprint-pr-previews",
      "database_id": "fc5334b4-f502-4944-98b9-8ad7e2f4a62e"
    }],
    "durable_objects": { "bindings": [{ "name": "NOTIFICATIONS", "class_name": "UserNotifications" }] }
  }
}
