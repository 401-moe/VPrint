{
  "name": "vprint",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "build": "tsc -p tsconfig.worker.json --noEmit && tsc --noEmit && vite build",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc --noEmit",
    "test:api": "vitest --config vitest.worker.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.27",
    "better-auth": "1.7.27",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
